{
  "name": "repo-ai-cli",
  "version": "0.8.0",
  "description": "AI repo CLI: bilingual README, CHANGELOG, commit/review/test/PR via your own LLM key; offline secrets scan, stats & deps audit",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "coverage:report": "node scripts/coverage-report.mjs",
    "pree2e": "npm run build",
    "e2e": "node scripts/e2e-smoke.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "prepublishOnly": "npm run build",
    "release": "changeset",
    "release:publish": "changeset publish",
    "release:version": "changeset version"
  },
  "keywords": [
    "cli",
    "ai",
    "llm",
    "readme",
    "commit",
    "changelog",
    "code-review",
    "byok",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bin": {
    "repo-ai-cli": "dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.8.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
